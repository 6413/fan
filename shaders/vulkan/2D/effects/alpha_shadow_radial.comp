#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) uniform sampler2D occluder_texture;
layout(set = 0, binding = 1, r16f) uniform writeonly image2D shadow_image;
layout(push_constant) uniform pc_t {
  uint angle_resolution;
  uint radial_samples;
} pc;
void main() {
  uint u = gl_GlobalInvocationID.x;
  if (u >= pc.angle_resolution) return;
  const float tau = 6.28318530718;
  float angle = float(u) / float(pc.angle_resolution) * tau;
  vec2 dir = vec2(cos(angle), sin(angle));
  float step_size = 1.0 / float(pc.radial_samples - 1);
  float blocker = 1.0;
  float accumulated = 0.0;
  for (int i = 0; i < int(pc.radial_samples); ++i) {
    float r = float(i) * step_size;
    float a = texture(occluder_texture, vec2(0.5) + dir * r * 0.5).r;
    if (a > 0.5) { blocker = r; break; }
    accumulated += a;
    if (accumulated >= 2.0) { blocker = r; break; }
  }
  imageStore(shadow_image, ivec2(int(u), 0), vec4(blocker, blocker, blocker, 1.0));
}
