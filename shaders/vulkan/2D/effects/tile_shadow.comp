#version 450
layout(local_size_x = 256) in;
struct occ_t { vec2 min; vec2 max; };
layout(set = 0, binding = 0) readonly buffer occluders_t { occ_t occs[]; };
layout(set = 0, binding = 1, r16f) uniform writeonly image2D shadow_map;
layout(push_constant) uniform pc_t {
  vec2 light_pos;
  float light_radius;
  uint occluder_count;
  uint angle_resolution;
} pc;

vec2 ray_aabb(vec2 mn, vec2 mx, vec2 origin, vec2 inv_dir) {
  vec2 t0 = (mn - origin) * inv_dir;
  vec2 t1 = (mx - origin) * inv_dir;
  float tmin = max(min(t0.x, t1.x), min(t0.y, t1.y));
  float tmax = min(max(t0.x, t1.x), max(t0.y, t1.y));
  return vec2(max(tmin, 0.0), tmax);
}

void main() {
  uint u = gl_GlobalInvocationID.x;
  if (u >= pc.angle_resolution) return;
  float tau = 6.28318530718;
  float angle = float(u) / float(pc.angle_resolution) * tau;
  vec2 dir = vec2(cos(angle), sin(angle));
  vec2 inv = vec2(abs(dir.x) < 0.000001 ? (dir.x < 0.0 ? -1e6 : 1e6) : 1.0 / dir.x,
                   abs(dir.y) < 0.000001 ? (dir.y < 0.0 ? -1e6 : 1e6) : 1.0 / dir.y);
  float blocker = 1.0;
  float lr2 = pc.light_radius * pc.light_radius;
  for (uint i = 0; i < pc.occluder_count; ++i) {
    vec2 center = (occs[i].min + occs[i].max) * 0.5;
    vec2 hsize = (occs[i].max - occs[i].min) * 0.5;
    vec2 to_occ = center - pc.light_pos;
    if (dot(to_occ, to_occ) > lr2 + hsize.x * hsize.x + hsize.y * hsize.y + 2.0 * pc.light_radius * max(hsize.x, hsize.y)) continue;
    vec2 hit = ray_aabb(occs[i].min, occs[i].max, pc.light_pos, inv);
    if (hit.y >= hit.x && hit.x < blocker * pc.light_radius) {
      blocker = hit.x / pc.light_radius;
      if (blocker <= 0.001) break;
    }
  }
  imageStore(shadow_map, ivec2(int(u), 0), vec4(blocker));
}